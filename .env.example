# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=your_access_token
PHONE_NUMBER_ID=your_phone_number_id
# Any string you choose; you enter the same one in the webhook config
VERIFY_TOKEN=my_secret_verify_token
# From App Dashboard > Settings > Basic (used to verify webhook signatures)
APP_SECRET=your_app_secret
GRAPH_VERSION=v21.0
